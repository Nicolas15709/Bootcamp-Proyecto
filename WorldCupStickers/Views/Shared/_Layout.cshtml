@{
    string? controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string? action = ViewContext.RouteData.Values["action"]?.ToString();
    string bodyClass = $"page-{controller?.ToLowerInvariant()} page-{controller?.ToLowerInvariant()}-{action?.ToLowerInvariant()}";
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WCS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Teko:wght@400;500;600;700&family=Bebas+Neue&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WorldCupStickers.styles.css" asp-append-version="true" />
</head>
<body class="@bodyClass" data-controller="@controller" data-action="@action">
    <div id="page-bar"></div>
    <div class="scene-backdrop" aria-hidden="true">
        <div class="scene-orb orb-a"></div>
        <div class="scene-orb orb-b"></div>
        <div class="scene-orb orb-c"></div>
        <div class="scene-grid"></div>
        <div class="scene-noise"></div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg wcs-navbar fixed-top" id="mainNavbar">
            <div class="container wcs-shell">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge">WCS</span>
                    <span class="brand-lockup">
                        <span class="brand-text">Sticker Command</span>
                        <span class="brand-sub">World Cup Archive</span>
                    </span>
                </a>

                <button class="navbar-toggler border-0" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Paises")" asp-controller="Paises" asp-action="Index">Paises</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Equipos")" asp-controller="Equipos" asp-action="Index">Equipos</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Jugadores")" asp-controller="Jugadores" asp-action="Index">Jugadores</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Cromos")" asp-controller="Cromos" asp-action="Index">Cromos</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Albumes")" asp-controller="Albumes" asp-action="Index">Albumes</a></li>
                    </ul>
                    <div class="nav-signal d-none d-lg-flex">
                        <span class="nav-signal-dot"></span>
                        <span>Live collection</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="wcs-main">
        <div class="container wcs-shell">
            <partial name="_AlertMessages" />
            @RenderBody()
        </div>
    </main>

    <footer class="wcs-footer mt-auto">
        <div class="container wcs-shell footer-inner">
            <div>
                <span class="footer-logo">World Cup Sticker Manager</span>
                <p class="footer-copy mb-0">Archivo visual para paises, equipos, jugadores, cromos y albumes.</p>
            </div>
            <div class="footer-meta">
                <span class="footer-pill">Redesign branch: diseno</span>
                <span class="footer-year">&copy; @DateTime.Now.Year</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/vanilla-tilt/1.8.1/vanilla-tilt.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
