@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Hero -->
<div class="wcs-hero">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <div class="hero-eyebrow">Gestor de Cromos Mundialistas</div>
            <h1 class="hero-title">WORLD CUP<br><span>STICKER MANAGER</span></h1>
            <p class="hero-sub">Administra tu colección del mundial. Jugadores, equipos, álbumes y cromos con fotos reales.</p>
            <div class="hero-btns">
                <a asp-controller="MiColeccion" asp-action="Index" class="btn btn-outline-wcs">
                    <i class="bi bi-collection me-1"></i>Ver mi colección
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Mi Colección stats -->
<h2 class="section-title mb-3"><span class="title-bar"></span>Mi Colección</h2>
<div class="row g-3 mb-5">
    <div class="col-6 col-md-4">
        <a asp-controller="MiColeccion" asp-action="Index" class="stat-card stat-dorado">
            <i class="bi bi-collection-fill stat-icon"></i>
            <div class="stat-num">@Model.MisCromos</div>
            <div class="stat-label">Mis Cromos</div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="MiColeccion" asp-action="Index" class="stat-card stat-rojo">
            <i class="bi bi-copy stat-icon"></i>
            <div class="stat-num">@Model.MisRepetidos</div>
            <div class="stat-label">Repetidos</div>
        </a>
    </div>
    <div class="col-6 col-md-4">
        <a asp-controller="Cromos" asp-action="Index" class="stat-card stat-azul">
            <i class="bi bi-question-circle stat-icon"></i>
            <div class="stat-num">@Model.MisFaltan</div>
            <div class="stat-label">Me faltan</div>
        </a>
    </div>
</div>

<!-- Últimos cromos -->
<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="section-title"><span class="title-bar"></span>Últimos cromos</h2>
    <a asp-controller="Cromos" asp-action="Index" class="btn btn-outline-wcs btn-sm">
        Ver todos <i class="bi bi-arrow-right ms-1"></i>
    </a>
</div>

@if (!Model.UltimosCromos.Any())
{
    <div class="alert alert-info">Aún no hay cromos registrados.</div>
}
else
{
    <div class="cromos-grid mb-5">
        @foreach (var cromo in Model.UltimosCromos)
        {
            <partial name="_CardCromo" model="cromo" />
        }
    </div>
}


@if (!Model.EquiposDestacados.Any())
{
    <div class="alert alert-info">Aún no hay equipos registrados.</div>
}
else
{
    <div class="row g-4">
        @foreach (var equipo in Model.EquiposDestacados)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_CardEquipo" model="equipo" />
            </div>
        }
    </div>
}
