@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<section class="stadium-hero">
    <div class="container position-relative stadium-content">
        <div class="stadium-title-wrap">
            <h1 class="stadium-title">
                <span class="stadium-line1">WORLD CUP</span>
                <span class="stadium-line2">STICKER MANAGER</span>
            </h1>
            <p class="stadium-desc">
                Administra tu colección del mundial. Jugadores, equipos, álbumes y
                cromos con fotos reales en una experiencia vibrante.
            </p>
            <a asp-controller="Cromos" asp-action="Create" class="btn btn-stadium-cta">
                <i class="bi bi-dribbble me-2"></i>Nuevo cromo
            </a>
        </div>
    </div>
</section>

<!-- ÚLTIMOS CROMOS -->
<section class="st-section">
    <div class="container">
        <div class="st-section-head">
            <h2 class="st-section-title">ÚLTIMOS <span>CROMOS</span></h2>
            <a asp-controller="Cromos" asp-action="Index" class="st-see-all">
                Ver todos <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        @if (!Model.UltimosCromos.Any())
        {
            <p class="text-muted">Aún no hay cromos registrados.</p>
        }
        else
        {
            <div class="st-cards-row">
                @foreach (var cromo in Model.UltimosCromos)
                {
                    <div class="st-card-slot">
                        <partial name="_CardCromo" model="cromo" />
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- EQUIPOS DESTACADOS -->
<section class="st-section">
    <div class="container">
        <div class="st-section-head">
            <h2 class="st-section-title">EQUIPOS <span>DESTACADOS</span></h2>
            <a asp-controller="Equipos" asp-action="Index" class="st-see-all">
                Ver todos <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        @if (!Model.EquiposDestacados.Any())
        {
            <p class="text-muted">Aún no hay equipos.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var equipo in Model.EquiposDestacados)
                {
                    <div class="col-md-6 col-xl-4">
                        <partial name="_CardEquipo" model="equipo" />
                    </div>
                }
            </div>
        }
    </div>
</section>
